{
  "name": "Zephyr STM32 DevContainer",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "zephyr",
  "workspaceFolder": "/workdir",
  "remoteUser": "root",
  // "runArgs": [
  //   "--privileged",
  //   "--device=/dev/bus/usb:/dev/bus/usb",
  //   "--group-add=plugdev"
  // ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "marus25.cortex-debug",
        "ms-python.python",
        "nordic-semiconductor.nrf-connect-extension-pack",
        "twxs.cmake",
        "ms-vscode.cmake-tools"
      ]
    }
  },
"postCreateCommand": [
"bash",
"-lc",
"cd /workdir && (west config manifest.path . && (source dependance/zephyr/zephyr-env.sh || (west init -l . && west update)))"
]}